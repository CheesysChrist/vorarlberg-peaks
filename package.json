{
  "name": "vorarlberg-peaks",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
